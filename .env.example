# Defaults to approved-only. Explicit review build only; never use as access control.
VITE_CONTENT_MODE=approved-only

# Server-only Vercel environment settings. Never prefix secrets with VITE_.
RESEND_API_KEY=
# Plain email address on your Resend-verified sending domain.
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Exact permitted origins, comma-separated, without trailing slashes.
CONTACT_ALLOWED_ORIGINS=
# Client-approved HTTPS calendly.com scheduling URL only.
CALENDLY_URL=
