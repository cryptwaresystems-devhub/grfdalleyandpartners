# Defaults to approved-only. Explicit review build only; never use as access control.
VITE_CONTENT_MODE=approved-only

# Server-only Vercel environment settings. Never prefix secrets with VITE_.
RESEND_API_KEY=
# Plain email address on your Resend-verified sending domain.
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Exact permitted origins, comma-separated, without trailing slashes.
CONTACT_ALLOWED_ORIGINS=
# Client-approved HTTPS calendly.com scheduling URL only.
CALENDLY_URL=

# Public GA4 stream ID (not a secret). Leave blank until approved/configured.
VITE_GA4_MEASUREMENT_ID=
# Set true only after disabling GA4 enhanced measurement and confirming manual views.
VITE_GA4_MANUAL_PAGEVIEWS_CONFIRMED=false
# Set production for non-Vercel production builds; VERCEL_ENV is checked automatically.
SITE_DEPLOYMENT_TARGET=staging

# Exact approved HTTPS website origin, without a path. Do not guess a launch hostname.
VITE_SITE_URL=
# Opt in only for a legally approved public launch. Staging stays false.
VITE_PUBLIC_INDEXING=false
