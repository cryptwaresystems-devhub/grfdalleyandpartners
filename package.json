{
  "name": "grf-dalley-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build.ts",
    "build:production": "tsx scripts/assert-production-ready.ts && npm run build",
    "launch:check": "tsx scripts/assert-production-ready.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "audit:build": "tsx scripts/measure-build.ts",
    "test:built": "tsx --test tests/built-site.check.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "content:report": "tsx scripts/content-report.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
